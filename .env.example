# RedSuture Environment Variables
# Powered by NextAI Studios
#
# RedSuture runs real penetration tests with its autonomous engine, which
# requires the engine runtime (Docker) to be running.

# Primary model that powers the RedSuture Agents, in LiteLLM format
# (e.g. gemini/gemini-4-argon, minimax/minimax-m3.1-flash, deepseek/deepseek-v4.1-flash)
RS_MODEL=gemini/gemini-4-argon

# API key for the primary model's provider.
# RS_API_KEY is preferred; LLM_API_KEY / ANTHROPIC_API_KEY / OPENAI_API_KEY are also accepted.
RS_API_KEY=your-provider-api-key-here

# Backup models, comma-separated (LiteLLM format). If the primary model's
# provider fails, the engine is re-run against each of these in order. Leave
# unset to use the built-in defaults (Gemini 4 Argon -> MiniMax -> GLM).
RS_MODEL_FALLBACKS=

# --- Engine runtime (see the internal runbook for the values to use) ---
# Full path to the engine binary. If set, it takes priority.
RS_ENGINE_BIN=
# The engine's command name and the directory it is installed in. When
# RS_ENGINE_BIN is unset, these are used to locate it (and prefix PATH).
RS_ENGINE_COMMAND=
RS_ENGINE_HOME=
# Name of the env var the engine reads for its model (passed to the child
# process). Leave unset to use a generic default.
RS_ENGINE_MODEL_ENV=
# Subdirectory the engine writes run artifacts into. Leave unset to detect the
# run directory automatically.
RS_ENGINE_RUN_SUBDIR=

# App Configuration
PORT=3333
NODE_ENV=development
