# RedSuture Environment Variables
# Powered by NextAI Studios
#
# RedSuture runs real penetration tests with Strix (https://github.com/usestrix/strix).
# Strix requires Docker to be running and the Strix CLI to be installed:
#   curl -sSL https://strix.ai/install | bash

# Primary model Strix uses, in LiteLLM format
# (e.g. anthropic/claude-sonnet-4-6, openai/gpt-5.4, openrouter/z-ai/glm-5.3)
STRIX_LLM=anthropic/claude-sonnet-4-6

# API key for the primary model's provider.
# LLM_API_KEY is preferred; ANTHROPIC_API_KEY / OPENAI_API_KEY are also accepted.
LLM_API_KEY=your-provider-api-key-here

# Backup models, comma-separated (LiteLLM format). If the primary model's
# provider fails, Strix is re-run against each of these in order. Leave unset
# to use the built-in defaults (Claude Sonnet -> GPT -> GLM).
STRIX_LLM_FALLBACKS=

# Path to the Strix binary. Leave empty to use ~/.strix/bin/strix or `strix` on PATH.
STRIX_BIN=

# App Configuration
PORT=3333
NODE_ENV=development
